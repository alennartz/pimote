{
  "name": "@pimote/server",
  "version": "0.16.0-rc.11",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true }); rmSync('tsconfig.tsbuildinfo', { force: true });\" && tsc -b --force",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "audit:themes": "tsx src/theme-audit-cli.ts",
    "theme-demo": "tsx ../tools/theme-demo/server.ts",
    "theme:normalize": "tsx src/theme-normalize-cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-schema": "^1.6.0",
    "@pimote/sdk": "0.16.0-rc.11",
    "@streamparser/json": "^0.0.22",
    "colorjs.io": "^0.7.1",
    "jiti": "^2.7.0",
    "semver": "^7.8.5",
    "typebox": "^1.1.38",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
