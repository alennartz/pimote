# Copy this file to .env.local and set the values for your development host.
# .env.local is ignored by Git. Every value is optional.
#
# Wireless ADB connect address of the phone, as shown on the Wireless debugging
# screen. Android changes the port each time wireless debugging restarts. Leave
# it unset to let discovery find a single advertising phone.
# ANDROID_DEVICE=192.168.1.240:40233

# Server URL to enter in the app on first launch. Printed before an install.
# ANDROID_SERVER_URL=http://192.168.1.10:3000

# ADB executable, when the default resolution picks the wrong key. The pairing
# key belongs to the ADB server that executable starts, so switching it can
# require one new `adb pair` on the phone.
# ANDROID_ADB=/mnt/c/Tools/android-sdk/platform-tools/adb.exe
