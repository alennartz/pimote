# Android build toolchain pins. tools/android-image passes each value to the
# image build. build.Dockerfile asserts every installed version against its pin.

# Base image digest keeps the JDK build immutable across rebuilds.
ANDROID_BASE_IMAGE=eclipse-temurin:17-jdk-jammy
ANDROID_BASE_IMAGE_DIGEST=sha256:978ed38b7785312f7761bee5e24cfcd7ac2fe466c5f07acee7b322e0bae6d0ec
ANDROID_JDK_MAJOR_VERSION=17

ANDROID_CMDLINE_TOOLS_VERSION=14742923
ANDROID_CMDLINE_TOOLS_REVISION=20.0

ANDROID_PLATFORM_VERSION=36
ANDROID_BUILD_TOOLS_VERSION=36.0.0
